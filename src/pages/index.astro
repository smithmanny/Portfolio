---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";

const [settings, { entry: home, cacheHint: homeCache }, { entries: featuredProjects, cacheHint: projectsCache }, { entries: recentPosts, cacheHint: postsCache }] =
	await Promise.all([
		getSiteSettings(),
		getEmDashEntry("pages", "home"),
		getEmDashCollection("projects", {
			orderBy: { published_at: "desc" },
			limit: 4,
		}),
		getEmDashCollection("posts", {
			orderBy: { published_at: "desc" },
			limit: 3,
		}),
	]);

if (Astro.cache?.enabled) {
	Astro.cache.set(homeCache);
	Astro.cache.set(projectsCache);
	Astro.cache.set(postsCache);
}
---

<Base>
	<section class="hero">
		<h1 class="hero-title">{settings?.title || "Shakhor Smith"}</h1>
		<p class="hero-tagline">{settings?.tagline || "Software Engineer"}</p>
	</section>

	{
		home?.data?.content && (
			<section class="home-intro">
				<div {...home?.edit?.content}>
					<PortableText value={home.data.content} />
				</div>
			</section>
		)
	}

	{
		featuredProjects.length > 0 ? (
			<section class="featured">
				<header class="section-header">
					<h2 class="section-title">Selected Work</h2>
					<a href="/work" class="section-link">
						All projects &rarr;
					</a>
				</header>
				<div class="projects-grid">
					{featuredProjects.map((project) => (
						<ProjectCard
							title={project.data.title ?? "Untitled"}
							summary={project.data.summary}
							featuredImage={project.data.featured_image ?? ""}
							href={`/work/${project.id}`}
							client={project.data.client}
							role={project.data.role}
							year={project.data.year}
							stack={project.data.stack as string[] | undefined}
						/>
					))}
				</div>
			</section>
		) : (
			<section class="empty-state">
				<h2>No projects yet</h2>
				<p>Add your first project in the admin panel.</p>
				<a href="/_emdash/admin/content/projects/new" class="btn">
					Add a project
				</a>
			</section>
		)
	}

	{
		recentPosts.length > 0 && (
			<section class="recent-posts">
				<header class="section-header">
					<h2 class="section-title">Recent Posts</h2>
					<a href="/blog" class="section-link">
						All posts &rarr;
					</a>
				</header>
				<div class="posts-list">
					{recentPosts.map((post) => (
						<PostCard
							title={post.data.title ?? "Untitled"}
							excerpt={post.data.excerpt}
							href={`/blog/${post.id}`}
							publishedAt={post.data.publishedAt}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="cta">
		<h2 class="cta-title">Work with me</h2>
		<p class="cta-text">
			Contract engineering, architecture reviews, or turning a half-built prototype
			into a product that survives production. I take on a few engagements a quarter.
		</p>
		<a href="/work-with-me" class="btn">Tell me about your project &rarr;</a>
	</section>
</Base>

<style>
	.hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-4xl) var(--spacing-lg);
		text-align: center;
	}

	.hero-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-md);
		letter-spacing: var(--tracking-tight);
	}

	.hero-tagline {
		font-size: var(--font-size-xl);
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-style: italic;
	}

	.home-intro {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-3xl);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
		text-align: center;
	}

	.home-intro :global(p) {
		margin-bottom: 1em;
	}

	.featured {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
	}

	.recent-posts {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-2xl);
		padding-bottom: var(--spacing-md);
		border-bottom: 1px solid var(--color-border);
	}

	.section-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
	}

	.section-link {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-text);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-2xl);
	}

	.cta {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg);
		text-align: center;
		border-top: 1px solid var(--color-border);
	}

	.cta-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-md);
	}

	.cta-text {
		max-width: 56ch;
		margin: 0 auto var(--spacing-xl);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.btn {
		display: inline-block;
		padding: var(--spacing-sm) var(--spacing-lg);
		background: var(--color-text);
		color: var(--color-bg);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		transition:
			background var(--transition-fast),
			transform var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand);
		color: var(--color-on-brand);
		transform: translateY(-1px);
	}

	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl) var(--spacing-lg);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-sm);
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-lg);
	}

	@media (max-width: 768px) {
		.hero {
			padding: var(--spacing-3xl) var(--spacing-lg);
		}

		.hero-title {
			font-size: var(--font-size-3xl);
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}

		.section-header {
			flex-direction: column;
			gap: var(--spacing-sm);
			align-items: flex-start;
		}
	}
</style>