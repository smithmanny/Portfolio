---
import { getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const [settings, { entry: page, cacheHint }] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", "about"),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const social = (settings?.social as Record<string, string> | undefined) ?? {};
---

<Base title="About" description="About Shakhor Smith — a software engineer working across IT, cloud, and AI.">
	<div class="about-page">
		<header class="about-header">
			<h1 class="about-title" {...page?.edit?.title}>
				{page?.data?.title || "About"}
			</h1>
		</header>

		<div class="about-content" {...page?.edit?.content}>
			{
				page?.data?.content ? (
					<PortableText value={page.data.content} />
				) : (
					<p>Content coming soon.</p>
				)
			}
		</div>

		<aside class="about-sidebar">
			<div class="sidebar-section">
				<h3>Let's work together</h3>
				<p>
					Contract engineering, architecture reviews, or bringing a prototype to
					production. I take on a few engagements each quarter.
				</p>
				<a href="/work-with-me" class="sidebar-cta">Work with me →</a>
			</div>

			{
				Object.keys(social).length > 0 && (
					<div class="sidebar-section">
						<h3>Elsewhere</h3>
						<ul class="sidebar-links">
							{Object.entries(social).map(([label, url]) => (
								<li>
									<a href={url} target="_blank" rel="noopener noreferrer">
										{label.charAt(0).toUpperCase() + label.slice(1)}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</aside>
	</div>
</Base>

<style>
	.about-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: auto 1fr;
		gap: var(--spacing-4xl);
	}

	.about-header {
		grid-column: 1 / -1;
	}

	.about-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.about-content {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
	}

	.about-content :global(p) {
		margin-bottom: 1.5em;
	}

	.about-content :global(h2) {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-top: 2.5em;
		margin-bottom: 0.75em;
	}

	.about-content :global(h3) {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-top: 2em;
		margin-bottom: 0.5em;
	}

	.about-sidebar {
		position: sticky;
		top: var(--spacing-xl);
		align-self: start;
	}

	.sidebar-section {
		margin-bottom: var(--spacing-2xl);
	}

	.sidebar-section h3 {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-md);
	}

	.sidebar-section p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-md);
	}

	.sidebar-cta {
		display: inline-block;
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.sidebar-cta:hover {
		color: var(--color-text);
	}

	.sidebar-links {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.sidebar-links a {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.sidebar-links a:hover {
		color: var(--color-text);
	}

	@media (max-width: 768px) {
		.about-page {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}

		.about-title {
			font-size: var(--font-size-3xl);
		}

		.about-sidebar {
			position: static;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-xl);
			padding-top: var(--spacing-xl);
			border-top: 1px solid var(--color-border);
		}

		.sidebar-section {
			margin-bottom: 0;
		}
	}

	@media (max-width: 480px) {
		.about-sidebar {
			grid-template-columns: 1fr;
		}
	}
</style>