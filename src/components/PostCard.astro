---
interface Props {
	title: string;
	excerpt?: string;
	href: string;
	publishedAt?: Date | null;
	tags?: string[];
}

const { title, excerpt, href, publishedAt, tags } = Astro.props;

const formattedDate = publishedAt?.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<article class="post-card">
	<a href={href} class="post-link">
		<div class="post-meta">
			{formattedDate && <time datetime={publishedAt!.toISOString()}>{formattedDate}</time>}
			{
				tags && tags.length > 0 && (
					<span class="post-tags">
						{tags.map((tag, i) => (
							<span>
								{i > 0 && <span class="post-tag-sep"> · </span>}
								{tag}
							</span>
						))}
					</span>
				)
			}
		</div>
		<h2 class="post-title">{title}</h2>
		{excerpt && <p class="post-excerpt">{excerpt}</p>}
	</a>
</article>

<style>
	.post-card {
		padding: var(--spacing-lg) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-card:first-child {
		padding-top: 0;
	}

	.post-link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.post-tags {
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		font-size: var(--font-size-xs);
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		max-width: 60ch;
	}
</style>